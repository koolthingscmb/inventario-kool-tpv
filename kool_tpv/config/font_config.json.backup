{
  "default": {
    "family": "Courier New",
    "size": 16,
    "weight": "normal",
    "fallback": ["Courier New", "Menlo", "DejaVu Sans Mono"],
    "line_height": 1.2
  },
  "label": {
    "family": "Courier New",
    "size": 16,
    "weight": "normal",
    "fallback": ["Courier New", "Menlo"]
  },
  "entry": {
    "family": "Courier New",
    "size": 14,
    "weight": "normal",
    "fallback": ["Courier New", "Menlo"]
  },
  "title": {
    "family": "Courier New",
    "size": 22,
    "weight": "bold",
    "fallback": ["Courier New"]
  },
  "subtitle": {
    "family": "Courier New",
    "size": 20,
    "weight": "bold",
    "fallback": ["Courier New"]
  },
  "breadcrumb": {
    "family": "Courier New",
    "size": 20,
    "weight": "bold",
    "fallback": ["Courier New"]
  },
  "caption": {
    "family": "Courier New",
    "size": 12,
    "weight": "normal",
    "fallback": ["Courier New"]
  },
  "large": {
    "family": "Courier New",
    "size": 26,
    "weight": "bold",
    "fallback": ["Courier New"]
  },
  "button": {
    "family": "Courier New",
    "size": 16,
    "weight": "bold",
    "fallback": ["Courier New"]
  },
  "tpv": {
    "search_button": {
      "family": "Courier New",
      "size": 24,
      "weight": "bold",
      "fallback": ["Courier New", "Menlo"]
    },
    "grid_button": {
      "family": "Courier New",
      "size": 36,
      "weight": "bold",
      "fallback": ["Courier New", "Menlo"]
    }
  },
  "app": {
    "base_font": {
      "family": "Courier New",
      "size": 18,
      "weight": "normal"
    },
    "nav_button": {
      "family": "Courier New",
      "size": 24,
      "weight": "bold"
    },
    "tpv_large": {
      "family": "Courier New",
      "size": 60,
      "weight": "bold"
    },
    "print_on": {
      "family": "Courier New",
      "size": 12,
      "weight": "bold"
    }
  },
  "components": {
    "action_button": {
      "family": "Courier New",
      "size": 20,
      "weight": "bold",
      "fallback": ["Courier New"]
    }
  },
  "dialog_title": {
    "family": "Courier New",
    "size": 40,
    "weight": "bold",
    "fallback": ["Courier New"]
  },
  "dialog_message": {
    "family": "Courier New",
    "size": 30,
    "weight": "bold",
    "fallback": ["Courier New"]
  },
  "dialog_button": {
    "family": "Courier New",
    "size": 25,
    "weight": "bold",
    "fallback": ["Courier New"]
  },
  "dialog_input": {
    "family": "Roboto-Regular",
    "size": 16,
    "weight": "normal",
    "fallback": ["Courier New", "Arial"]
  },
  "modules": {
    "config": {
      "label": { "size": 16 },
      "entry": { "size": 14 }
    }
  },
  "scale": {
    "global_factor": 1.0
  }
}
